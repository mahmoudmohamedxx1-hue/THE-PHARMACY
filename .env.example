# ---- Required ----
# SQLite catalog (committed to the repo). Can be an absolute path or relative
# to the prisma/ directory. If unset, the app falls back to <project>/db/custom.db
DATABASE_URL=file:../db/custom.db

# ---- Recommended (production) ----
# Public site URL — used for SEO tags, sitemap.xml and social link previews
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Optional: email notifications (Resend) ----
# Order confirmations + status updates are emailed when this key is set.
# Without it the app silently skips email (no errors).
# Free tier: https://resend.com — verify your domain, then set:
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="The Pharmacy <orders@your-domain.com>"

# ---- Optional: analytics ----
# GA4 measurement ID (G-XXXXXXX) — loads gtag.js only when set
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta Pixel ID — loads the pixel snippet only when set
# NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Note: the first-party analytics funnel (page views / add-to-cart /
# checkout / purchase) is always collected into the app's own database and
# shown in the admin dashboard — no external account needed.
