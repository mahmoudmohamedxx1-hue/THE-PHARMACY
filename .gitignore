# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# SQLite runtime files (only the .db file itself is committed)
db/*.db-shm
db/*.db-wal

# scraped-source data repo (kept out of the app repo; preserved on branch research-data)
chefaa-source/

# chat file uploads
upload/

# reference clones (netstream/egxdesk configs) — local only
.reference/

# sandbox runtime artifacts — dev junk stays out, platform infra is tracked (egxdesk pattern)
.zscripts/dev.pid
tool-results/
examples/
tests/

# test + repair artifacts
test-results/
playwright-report/
db/backup/
